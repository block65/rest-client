// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the default serializer's output > a Date, through toJSON 1`] = `"at=1970-01-01T00%3A00%3A00.000Z"`;

exports[`the default serializer's output > a lone surrogate 1`] = `"a=%EF%BF%BD"`;

exports[`the default serializer's output > a nested object, hoisted 1`] = `"gt=1&lte=2"`;

exports[`the default serializer's output > a plain string 1`] = `"a=one"`;

exports[`the default serializer's output > a space 1`] = `"a=one%20two"`;

exports[`the default serializer's output > an array 1`] = `"a=one&a=two"`;

exports[`the default serializer's output > null 1`] = `"b=keep"`;

exports[`the default serializer's output > reserved characters 1`] = `"a=a%26b%3Dc%23d%3Fe%2Ff"`;

exports[`the default serializer's output > undefined 1`] = `"b=keep"`;

exports[`the default serializer's output > unicode 1`] = `"a=caf%C3%A9%20%F0%9F%8E%89"`;
